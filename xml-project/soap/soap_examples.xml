<!-- ================================================================== -->
<!-- Operation 1: getPredictedPrice                                      -->
<!-- ================================================================== -->

<!-- REQUEST -->
<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/"
                  xmlns:hous="http://housing.com/prices">
    <soapenv:Header/>
    <soapenv:Body>
        <hous:GetPredictedPriceRequest>
            <hous:overallQual>7</hous:overallQual>
            <hous:grLivArea>1710</hous:grLivArea>
            <hous:totalBsmtSF>856</hous:totalBsmtSF>
            <hous:yearBuilt>2003</hous:yearBuilt>
            <hous:garageCars>2</hous:garageCars>
            <hous:neighborhood>CollgCr</hous:neighborhood>
            <hous:centralAir>Y</hous:centralAir>
        </hous:GetPredictedPriceRequest>
    </soapenv:Body>
</soapenv:Envelope>

<!-- RESPONSE -->
<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/"
                  xmlns:hous="http://housing.com/prices">
    <soapenv:Header/>
    <soapenv:Body>
        <hous:GetPredictedPriceResponse>
            <hous:predictedPrice>208750.00</hous:predictedPrice>
            <hous:pricePerSqft>82.15</hous:pricePerSqft>
            <hous:confidence>High</hous:confidence>
        </hous:GetPredictedPriceResponse>
    </soapenv:Body>
</soapenv:Envelope>

